{
  "resource": {
    "oid": "25e166d6-9899-43b7-b0d7-4c4c526b7a9e",
    "name": "Users CSV",
    "lifecycleState": "active",
    "connectorRef": {
      "type": "c:ConnectorType",
      "filter": {
        "and": {
          "equal": [
            {
              "path": "connectorType",
              "value": "com.evolveum.polygon.connector.csv.CsvConnector"
            },
            {
              "path": "connectorVersion",
              "value": "2.8"
            }
          ]
        }
      }
    },
    "connectorConfiguration": {
      "@ns": "http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/connector-schema-3",
      "configurationProperties": {
        "@ns": "http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/bundle/com.evolveum.polygon.connector-csv/com.evolveum.polygon.connector.csv.CsvConnector",
        "filePath": "/data/users.csv",
        "encoding": "utf-8",
        "fieldDelimiter": ",",
        "uniqueAttribute": "USERNAME",
        "nameAttribute": "USERNAME"
      }
    },
    "schemaHandling": {
      "objectType": [
        {
          "kind": "account",
          "intent": "default",
          "displayName": "Default account",
          "default": true,
          "delineation": {
            "objectClass": "ri:AccountObjectClass"
          },
          "focus": {
            "type": "c:UserType"
          },
          "attribute": [
            {
              "ref": "ri:USERNAME",
              "outbound": {
                "strength": "strong",
                "source": [
                  {
                    "path": "name"
                  }
                ],
                "expression": {
                  "script": {
                    "code": "// The login is the lower-cased midPoint name.\nname?.toLowerCase()"
                  }
                }
              }
            },
            {
              "ref": "ri:DISPLAY_NAME",
              "outbound": {
                "source": [
                  {
                    "path": "fullName"
                  }
                ],
                "expression": {
                  "script": {
                    "code": "def n = fullName?.orig\nreturn n ? \"${n} (CSV)\" : null\n"
                  }
                }
              }
            },
            {
              "ref": "ri:GROUPS",
              "displayName": "Groups"
            }
          ]
        }
      ]
    },
    "capabilities": {
      "native": {
        "schema": {},
        "create": {},
        "read": {}
      }
    }
  }
}
