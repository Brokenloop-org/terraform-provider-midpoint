<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="urn:t" xmlns:tns="urn:t" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:a="http://prism.evolveum.com/xml/ns/public/annotation-3">
  <xsd:group name="Pair">
    <xsd:sequence><xsd:element name="left" type="xsd:string"/><xsd:element name="right" type="xsd:string" maxOccurs="2"/></xsd:sequence>
  </xsd:group>
  <xsd:attributeGroup name="Inner"><xsd:attribute name="deepAttr" type="xsd:string"/></xsd:attributeGroup>
  <xsd:attributeGroup name="Attrs">
    <xsd:attribute name="groupAttr" type="xsd:boolean"/>
    <xsd:attributeGroup ref="tns:Inner"/>
  </xsd:attributeGroup>
  <xsd:complexType name="UsesGroups">
    <xsd:sequence><xsd:group ref="tns:Pair"/></xsd:sequence>
    <xsd:attributeGroup ref="tns:Attrs"/>
  </xsd:complexType>
  <xsd:complexType name="RepeatedGroup">
    <xsd:sequence><xsd:group ref="tns:Pair" maxOccurs="unbounded"/></xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="UnknownGroup"><xsd:sequence><xsd:group ref="tns:Missing"/></xsd:sequence></xsd:complexType>
</xsd:schema>
