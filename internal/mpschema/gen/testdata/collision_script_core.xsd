<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="urn:core" xmlns:tns="urn:core" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:a="http://prism.evolveum.com/xml/ns/public/annotation-3">
