<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="urn:t" xmlns:tns="urn:t" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:a="http://prism.evolveum.com/xml/ns/public/annotation-3">
  <xsd:element name="evaluator" type="tns:EvaluatorBase"/>
  <xsd:complexType name="EvaluatorBase"><xsd:sequence/></xsd:complexType>
  <xsd:complexType name="ConstEval"><xsd:sequence><xsd:element name="v" type="xsd:string"/></xsd:sequence></xsd:complexType>
  <xsd:complexType name="NestedEval"><xsd:sequence><xsd:element name="n" type="xsd:string"/></xsd:sequence></xsd:complexType>
  <xsd:element name="const" type="tns:ConstEval" substitutionGroup="tns:evaluator"/>
  <xsd:element name="nested" type="tns:NestedEval" substitutionGroup="tns:const"/>
  <xsd:complexType name="Many">
    <xsd:sequence><xsd:element ref="tns:evaluator" maxOccurs="unbounded"/></xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="One">
    <xsd:sequence><xsd:element ref="tns:evaluator" minOccurs="0"/></xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="SameLocalNameNotARef">
    <xsd:sequence><xsd:element name="evaluator" type="xsd:string"/></xsd:sequence>
  </xsd:complexType>
</xsd:schema>
