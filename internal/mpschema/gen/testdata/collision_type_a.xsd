<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="urn:a" xmlns:tns="urn:a" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:a="http://prism.evolveum.com/xml/ns/public/annotation-3">
  <xsd:complexType name="Shared"><xsd:sequence><xsd:element name="fromA" type="xsd:string"/></xsd:sequence></xsd:complexType>
  <xsd:complexType name="Same"><xsd:sequence><xsd:element name="x" type="xsd:string"/></xsd:sequence></xsd:complexType>
  <xsd:complexType name="ChildOfShared">
    <xsd:complexContent><xsd:extension base="tns:Shared"><xsd:sequence><xsd:element name="own" type="xsd:string"/></xsd:sequence></xsd:extension></xsd:complexContent>
  </xsd:complexType>
  <xsd:simpleType name="Color"><xsd:restriction base="xsd:string"><xsd:enumeration value="red"/></xsd:restriction></xsd:simpleType>
  <xsd:simpleType name="SameEnum"><xsd:restriction base="xsd:string"><xsd:enumeration value="a"/><xsd:enumeration value="b"/></xsd:restriction></xsd:simpleType>
  <xsd:simpleType name="Both"><xsd:restriction base="xsd:string"/></xsd:simpleType>
  <xsd:complexType name="UsesColor"><xsd:sequence><xsd:element name="color" type="tns:Color"/><xsd:element name="same" type="tns:SameEnum"/></xsd:sequence></xsd:complexType>
</xsd:schema>
